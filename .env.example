# Copy this file to .env in the project root and replace the placeholder(s)
# with your real key(s). config.py loads .env automatically; shell exports
# take precedence over .env values. Never commit .env.

# DeepSeek official API (DEFAULT provider; model: deepseek-v4-pro)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter (optional fallback provider — used only when DEEPSEEK_API_KEY
# is absent)
OPENROUTER_API_KEY=your_openrouter_api_key_here
