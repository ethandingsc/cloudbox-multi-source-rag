# Copy this file to .env in the project root and replace the placeholder(s)
# with your real key(s). config.py loads .env automatically; shell exports
# take precedence over .env values. Never commit .env.

# Safe default: a failed free request never falls through to a paid provider.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
CLOUDBOX_ALLOW_PAID_LLM=0
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional paid provider. DeepSeek is used only when LLM_PROVIDER=deepseek
# and CLOUDBOX_ALLOW_PAID_LLM=1 are both set explicitly.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
